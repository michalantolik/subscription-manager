@SubscriptionManager.Api_HostAddress = http://localhost:5159

### Create subscription

POST {{SubscriptionManager.Api_HostAddress}}/api/subscriptions
Content-Type: application/json

{
  "name": "Netflix",
  "amount": 49.00,
  "currency": "PLN",
  "billingPeriod": "Monthly",
  "startDate": "2026-07-18"
}

###

### Create invalid subscription

POST {{SubscriptionManager.Api_HostAddress}}/api/subscriptions
Content-Type: application/json

{
  "name": "",
  "amount": 49.00,
  "currency": "PLN",
  "billingPeriod": "Monthly",
  "startDate": "2026-07-18"
}

###

### Register user

POST {{SubscriptionManager.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "michal@example.com",
  "password": "Test123!"
}

###

### Register the same user again

POST {{SubscriptionManager.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "michal@example.com",
  "password": "Test123!"
}

###

### Confirm user email
# Replace UserId with the value returned by the register request.
# Replace ConfirmationToken with the token written to the API console logs.

POST {{SubscriptionManager.Api_HostAddress}}/api/auth/confirm-email
Content-Type: application/json

{
  "userId": "00000000-0000-0000-0000-000000000000",
  "confirmationToken": "replace-with-confirmation-token"
}
