@page "/register"
@using SubscriptionManager.Web.Features.Authentication
@using SubscriptionManager.Web.Common.Currencies



@attribute [AllowAnonymous]

@inject Localizer T

<PageTitle>
    Subscription Manager — @T["Authentication.Register.Title"]
</PageTitle>

<section class="page register-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">
                @T["Authentication.Register.Eyebrow"]
            </p>

            <h1>
                @T["Authentication.Register.Title"]
            </h1>

            <p>
                @T["Authentication.Register.Description"]
            </p>
        </div>
    </div>

    <div class="ui-card register-card">
        @if (IsCreated)
        {
            <div class="ui-form">
                <div class="ui-alert ui-alert-success"
                     role="status">
                    @T["Authentication.Register.Success"]
                </div>

                <div class="ui-form-actions">
                    <a class="primary-button"
                       href="/login">
                        @T["Authentication.GoToSignIn"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <form method="post"
                  action="/authentication/register">
                <AntiforgeryToken />

                <div class="ui-form">
                    <div class="register-form-sections">
                        <div class="ui-form-section register-form-section">
                            <div class="ui-form-section-header">
                                <h2 class="ui-form-section-title">
                                    @T["Authentication.Register.FormTitle"]
                                </h2>

                                <p class="ui-form-section-description">
                                    @T["Authentication.Register.FormDescription"]
                                </p>
                            </div>

                            <div class="ui-form-grid ui-form-grid-single">
                                <div class="ui-field">
                                    <div class="ui-field-heading">
                                        <label class="ui-label"
                                               for="register-email">
                                            @T["Field.Email"]
                                        </label>
                                    </div>

                                    <input id="register-email"
                                           class="ui-control"
                                           name="email"
                                           type="email"
                                           autocomplete="username"
                                           placeholder="@T["Field.EmailPlaceholder"]"
                                           required />
                                </div>

                                <div class="ui-field">
                                    <div class="ui-field-heading">
                                        <label class="ui-label"
                                               for="register-password">
                                            @T["Authentication.Password"]
                                        </label>
                                    </div>

                                    <input id="register-password"
                                           class="ui-control"
                                           name="password"
                                           type="password"
                                           minlength="8"
                                           autocomplete="new-password"
                                           placeholder="@T["Authentication.PasswordPlaceholder"]"
                                           required />
                                </div>

                                <div class="ui-field">
                                    <div class="ui-field-heading">
                                        <label class="ui-label"
                                               for="register-confirm-password">
                                            @T["Authentication.ConfirmPassword"]
                                        </label>
                                    </div>

                                    <input id="register-confirm-password"
                                           class="ui-control"
                                           name="confirmPassword"
                                           type="password"
                                           minlength="8"
                                           autocomplete="new-password"
                                           placeholder="@T["Authentication.Register.ConfirmPasswordPlaceholder"]"
                                           required />
                                </div>
                            </div>
                        </div>

                        <div class="ui-form-section register-form-section">
                            <div class="ui-form-section-header">
                                <h2 class="ui-form-section-title">
                                    @T["Authentication.Register.PreferencesTitle"]
                                </h2>

                                <p class="ui-form-section-description">
                                    @T["Authentication.Register.PreferencesDescription"]
                                </p>
                            </div>

                            <div class="ui-form-grid ui-form-grid-single">
                                <div class="ui-field">
                                    <div class="ui-field-heading">
                                        <label class="ui-label"
                                               for="register-language">
                                            @T["Authentication.Register.LanguageLabel"]
                                        </label>
                                    </div>

                                    <select id="register-language"
                                            class="ui-control"
                                            name="language"
                                            required>
                                        @foreach (var language in Languages)
                                        {
                                            <option value="@language.Value"
                                                    selected="@(language.Value == DefaultLanguage)">
                                                @language.Label
                                            </option>
                                        }
                                    </select>

                                    <span class="ui-help">
                                        @T["Authentication.Register.LanguageDescription"]
                                    </span>
                                </div>

                                <div class="ui-field">
                                    <div class="ui-field-heading">
                                        <label class="ui-label"
                                               for="register-base-currency">
                                            @T["Authentication.Register.BaseCurrencyLabel"]
                                        </label>
                                    </div>

                                    <select id="register-base-currency"
                                            class="ui-control"
                                            name="baseCurrency"
                                            required>
                                        @foreach (var currency in Enum.GetValues<Currency>())
                                        {
                                            <option value="@currency"
                                                    selected="@(currency == DefaultBaseCurrency)">
                                                @currency
                                            </option>
                                        }
                                    </select>

                                    <span class="ui-help">
                                        @T["Authentication.Register.BaseCurrencyDescription"]
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (ErrorMessages.Count > 0)
                    {
                        <div class="ui-alert ui-alert-error"
                             role="alert">
                            @if (ErrorMessages.Count == 1)
                            {
                                @ErrorMessages[0]
                            }
                            else
                            {
                                <ul class="ui-alert-list">
                                    @foreach (var message in ErrorMessages)
                                    {
                                        <li>@message</li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <div class="ui-form-actions register-form-actions">
                        <a class="secondary-button"
                           href="/login">
                            @T["Authentication.BackToSignIn"]
                        </a>

                        <button class="primary-button"
                                type="submit">
                            @T["Authentication.Register.Submit"]
                        </button>
                    </div>
                </div>
            </form>
        }
    </div>
</section>
