@page "/forgot-password"
@using SubscriptionManager.Web.Features.Authentication


@attribute [AllowAnonymous]

@inject AuthenticationApiClient ApiClient
@inject Localizer T

<PageTitle>Subscription Manager — @T["Authentication.Title"]</PageTitle>

<section class="page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">@T["Authentication.Title"]</p>
            <h1>@T["Authentication.Title"]</h1>
            <p>@T["Authentication.Description"]</p>
        </div>
    </div>

    <div class="ui-card" style="max-width: 560px;">
        @if (_isCompleted)
        {
            <div class="ui-form">
                <div class="ui-alert ui-alert-success"
                     role="status">
                    @T["Status.Success"]
                </div>

                <div class="ui-form-actions">
                    <a class="secondary-button"
                       href="/">
                        @T["Action.BackToLogin"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="_model"
                      OnValidSubmit="SubmitAsync"
                      FormName="forgot-password">
                <DataAnnotationsValidator />

                <div class="ui-form">
                    <div class="ui-form-section">
                        <div class="ui-form-section-header">
                            <h2 class="ui-form-section-title">
                                @T["Authentication.Title"]
                            </h2>

                            <p class="ui-form-section-description">
                                @T["Authentication.Description"]
                            </p>
                        </div>

                        <div class="ui-form-grid ui-form-grid-single">
                            <div class="ui-field">
                                <div class="ui-field-heading">
                                    <label class="ui-label"
                                           for="forgot-password-email">
                                        @T["Field.Email"]
                                    </label>
                                </div>

                                <InputText id="forgot-password-email"
                                           class="ui-control"
                                           type="email"
                                           autocomplete="email"
                                           placeholder="@T["Field.EmailPlaceholder"]"
                                           @bind-Value="_model.Email" />

                                <ValidationMessage For="() => _model.Email"
                                                   class="ui-error" />
                            </div>
                        </div>
                    </div>

                    @if (_hasError)
                    {
                        <div class="ui-alert ui-alert-error"
                             role="alert">
                            @T["Error.Authentication"]
                        </div>
                    }

                    <div class="ui-form-actions">
                        <a class="secondary-button"
                           href="/">
                            @T["Action.BackToLogin"]
                        </a>

                        <button class="primary-button"
                                type="submit"
                                disabled="@_isSubmitting">
                            @(_isSubmitting
                                ? T["Status.Sending"]
                                : T["Action.SendResetLink"])
                        </button>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</section>
