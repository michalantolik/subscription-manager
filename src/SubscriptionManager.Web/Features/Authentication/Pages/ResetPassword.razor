@page "/reset-password"
@using SubscriptionManager.Web.Features.Authentication


@attribute [AllowAnonymous]

@inject AuthenticationApiClient ApiClient
@inject Localizer T

<PageTitle>
    Subscription Manager — @T["Authentication.ResetPassword.Title"]
</PageTitle>

<section class="page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">
                @T["Authentication.ResetPassword.Eyebrow"]
            </p>

            <h1>
                @T["Authentication.ResetPassword.Title"]
            </h1>

            <p>
                @T["Authentication.ResetPassword.Description"]
            </p>
        </div>
    </div>

    <div class="ui-card" style="max-width: 560px;">
        @if (_isCompleted)
        {
            <div class="ui-form">
                <div class="ui-alert ui-alert-success"
                     role="status">
                    @T["Authentication.ResetPassword.Success"]
                </div>

                <div class="ui-form-actions">
                    <a class="primary-button"
                       href="/">
                        @T["Authentication.GoToSignIn"]
                    </a>
                </div>
            </div>
        }
        else if (!_hasValidResetLink)
        {
            <div class="ui-form">
                <div class="ui-alert ui-alert-error"
                     role="alert">
                    @T["Authentication.ResetPassword.InvalidLink"]
                </div>

                <div class="ui-form-actions">
                    <a class="secondary-button"
                       href="/forgot-password">
                        @T["Authentication.ResetPassword.RequestNewLink"]
                    </a>

                    <a class="primary-button"
                       href="/">
                        @T["Authentication.BackToSignIn"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="_model"
                      OnValidSubmit="SubmitAsync"
                      FormName="reset-password">
                <DataAnnotationsValidator />

                <div class="ui-form">
                    <div class="ui-form-section">
                        <div class="ui-form-section-header">
                            <h2 class="ui-form-section-title">
                                @T["Authentication.ResetPassword.FormTitle"]
                            </h2>

                            <p class="ui-form-section-description">
                                @T["Authentication.ResetPassword.FormDescription"]
                            </p>
                        </div>

                        <div class="ui-form-grid ui-form-grid-single">
                            <div class="ui-field">
                                <div class="ui-field-heading">
                                    <label class="ui-label"
                                           for="reset-password-new-password">
                                        @T["Authentication.NewPassword"]
                                    </label>
                                </div>

                                <InputText id="reset-password-new-password"
                                           class="ui-control"
                                           type="password"
                                           autocomplete="new-password"
                                           placeholder="@T["Authentication.NewPasswordPlaceholder"]"
                                           @bind-Value="_model.NewPassword" />

                                <ValidationMessage For="() => _model.NewPassword"
                                                   class="ui-error" />
                            </div>

                            <div class="ui-field">
                                <div class="ui-field-heading">
                                    <label class="ui-label"
                                           for="reset-password-confirm-password">
                                        @T["Authentication.ConfirmPassword"]
                                    </label>
                                </div>

                                <InputText id="reset-password-confirm-password"
                                           class="ui-control"
                                           type="password"
                                           autocomplete="new-password"
                                           placeholder="@T["Authentication.ConfirmPasswordPlaceholder"]"
                                           @bind-Value="_model.ConfirmPassword" />

                                <ValidationMessage For="() => _model.ConfirmPassword"
                                                   class="ui-error" />
                            </div>
                        </div>
                    </div>

                    @if (_hasError)
                    {
                        <div class="ui-alert ui-alert-error"
                             role="alert">
                            @T["Authentication.ResetPassword.Error"]
                        </div>
                    }

                    <div class="ui-form-actions">
                        <a class="secondary-button"
                           href="/">
                            @T["Authentication.BackToSignIn"]
                        </a>

                        <button class="primary-button"
                                type="submit"
                                disabled="@_isSubmitting">
                            @(_isSubmitting
                                ? T["Authentication.ResetPassword.Saving"]
                                : T["Authentication.ResetPassword.Submit"])
                        </button>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</section>
