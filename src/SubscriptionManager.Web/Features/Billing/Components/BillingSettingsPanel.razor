@using SubscriptionManager.Web.Features.Billing

@inject BillingApiClient BillingApiClient
@inject Localizer T

@if (_isLoading)
{
    <div class="billing-settings-loading"
         role="status">
        <span class="billing-settings-spinner"
              aria-hidden="true"></span>

        @T["Billing.Settings.Loading"]
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="ui-alert ui-alert-error"
         role="alert">
        <strong>
            @T["Billing.Settings.LoadingErrorTitle"]
        </strong>

        <span>@_error</span>
    </div>

    <button class="secondary-button"
            type="button"
            @onclick="ReloadAsync">
        @T["Action.TryAgain"]
    </button>
}
else if (_overview is not null)
{
    @if (_stage == BillingSettingsStage.Overview)
    {
        <section class="billing-current-plan"
                 aria-labelledby="billing-current-plan-title">
            <div class="billing-current-plan-heading">
                <div>
                    <span class="ui-badge ui-badge-brand">
                        @T["Billing.Settings.CurrentPlan"]
                    </span>

                    <h4 id="billing-current-plan-title">
                        @PlanLabel
                    </h4>

                    <p>@PlanDescription</p>
                </div>

                <span class="billing-plan-mark">
                    <AppIcon Name="subscriptions" />
                </span>
            </div>

            @if (_overview.Plan != BillingPlan.Free)
            {
                <dl class="billing-details">
                    <div>
                        <dt>
                            @T["Billing.Settings.BillingInterval"]
                        </dt>

                        <dd>@BillingIntervalLabel</dd>
                    </div>

                    <div>
                        <dt>
                            @T["Billing.Settings.Status"]
                        </dt>

                        <dd>
                            <span class="billing-status @StatusClass">
                                @StatusLabel
                            </span>
                        </dd>
                    </div>

                    <div>
                        <dt>@RenewalDateLabel</dt>
                        <dd>@CurrentPeriodEndText</dd>
                    </div>
                </dl>

                @if (_overview.CancelAtPeriodEnd)
                {
                    <div class="ui-alert ui-alert-warning"
                         role="status">
                        <strong>
                            @T["Billing.Settings.CancellationScheduledTitle"]
                        </strong>

                        <span>
                            @string.Format(
                                T["Billing.Settings.CancellationScheduledDescription"],
                                CurrentPeriodEndText)
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="billing-free-plan-note">
                    <AppIcon Name="check" />

                    <span>
                        <strong>
                            @T["Billing.Settings.FreePlanTitle"]
                        </strong>

                        @T["Billing.Settings.FreePlanDescription"]
                    </span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_operationError))
            {
                <div class="ui-alert ui-alert-error"
                     role="alert">
                    @_operationError
                </div>
            }

            <div class="billing-actions">
                <button class="primary-button"
                        type="button"
                        disabled="@_isProcessing"
                        @onclick="OpenPlanSelection">
                    @(_overview.Plan == BillingPlan.Free
                        ? T["Billing.Settings.ComparePlans"]
                        : T["Billing.Settings.ChangePlan"])
                </button>

                @if (_overview.Plan != BillingPlan.Free)
                {
                    @if (_overview.CancelAtPeriodEnd)
                    {
                        <button class="secondary-button"
                                type="button"
                                disabled="@_isProcessing"
                                @onclick="ResumeAsync">
                            @(_isProcessing
                                ? T["Billing.Settings.Resuming"]
                                : T["Billing.Settings.Resume"])
                        </button>
                    }
                    else
                    {
                        <button class="text-button billing-cancel-button"
                                type="button"
                                disabled="@_isProcessing"
                                @onclick="OpenCancellationConfirmation">
                            @T["Billing.Settings.Cancel"]
                        </button>
                    }
                }
            </div>
        </section>
    }
    else if (_stage == BillingSettingsStage.PlanSelection)
    {
        <section class="billing-plan-selection"
                 aria-labelledby="billing-plan-selection-title">
            <div class="billing-section-heading">
                <div>
                    <span class="ui-badge ui-badge-brand">
                        @T["Billing.Plans.Badge"]
                    </span>

                    <h4 id="billing-plan-selection-title">
                        @T["Billing.Plans.Title"]
                    </h4>

                    <p>
                        @T["Billing.Plans.Description"]
                    </p>
                </div>

                <button class="text-button"
                        type="button"
                        disabled="@_isProcessing"
                        @onclick="BackToOverview">
                    @T["Action.Back"]
                </button>
            </div>

            @if (!PaidPlansEnabled)
            {
                <div class="ui-alert ui-alert-warning"
                     role="status">
                    <strong>
                        @T["Billing.Plans.PaidPlansUnavailableTitle"]
                    </strong>

                    <span>
                        @T["Billing.Plans.PaidPlansUnavailableDescription"]
                    </span>
                </div>
            }

            <div class="billing-interval-selector"
                 role="group"
                 aria-label="@T["Billing.Plans.BillingInterval"]">
                <button class="@(
                            _selectedBillingInterval ==
                            BillingInterval.Monthly
                                ? "billing-interval-option billing-interval-option-selected"
                                : "billing-interval-option")"
                        type="button"
                        disabled="@_isProcessing"
                        aria-pressed="@(
                            _selectedBillingInterval ==
                            BillingInterval.Monthly)"
                        @onclick="@(
                            () => SelectBillingInterval(
                                BillingInterval.Monthly))">
                    @T["Billing.Interval.Monthly"]
                </button>

                <button class="@(
                            _selectedBillingInterval ==
                            BillingInterval.Yearly
                                ? "billing-interval-option billing-interval-option-selected"
                                : "billing-interval-option")"
                        type="button"
                        disabled="@_isProcessing"
                        aria-pressed="@(
                            _selectedBillingInterval ==
                            BillingInterval.Yearly)"
                        @onclick="@(
                            () => SelectBillingInterval(
                                BillingInterval.Yearly))">
                    @T["Billing.Interval.Yearly"]
                </button>
            </div>

            @if (_isLoadingPlans)
            {
                <div class="billing-settings-loading"
                     role="status">
                    <span class="billing-settings-spinner"
                          aria-hidden="true"></span>

                    @T["Billing.Plans.Loading"]
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_plansError))
            {
                <div class="ui-alert ui-alert-error"
                     role="alert">
                    <strong>
                        @T["Billing.Plans.LoadingErrorTitle"]
                    </strong>

                    <span>@_plansError</span>
                </div>

                <button class="secondary-button"
                        type="button"
                        @onclick="LoadPlansAsync">
                    @T["Action.TryAgain"]
                </button>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_operationError))
                {
                    <div class="ui-alert ui-alert-error"
                         role="alert">
                        @_operationError
                    </div>
                }

                <div class="billing-plan-grid">
                    <article class="@(
                                 _overview.Plan == BillingPlan.Free
                                     ? "billing-plan-card billing-plan-card-current"
                                     : "billing-plan-card")">
                        <div class="billing-plan-card-heading">
                            <div>
                                <h5>
                                    @T["Billing.Plan.Free"]
                                </h5>

                                <p>
                                    @T["Billing.Plan.FreeDescription"]
                                </p>
                            </div>

                            @if (_overview.Plan == BillingPlan.Free)
                            {
                                <span class="ui-badge ui-badge-brand">
                                    @T["Billing.Plans.Current"]
                                </span>
                            }
                        </div>

                        <div class="billing-plan-price">
                            <strong>
                                @T["Billing.Plans.FreePrice"]
                            </strong>
                        </div>

                        <ul class="billing-plan-features">
                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Free.Feature1"]
                            </li>

                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Free.Feature2"]
                            </li>

                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Free.Feature3"]
                            </li>
                        </ul>

                        <button class="secondary-button"
                                type="button"
                                disabled="@(
                                    _isProcessing ||
                                    _overview.Plan ==
                                    BillingPlan.Free)"
                                @onclick="@(
                                    () => SelectPlanAsync(
                                        BillingPlan.Free))">
                            @if (_overview.Plan == BillingPlan.Free)
                            {
                                @T["Billing.Plans.Current"]
                            }
                            else
                            {
                                @T["Billing.Plans.Select"]
                            }
                        </button>
                    </article>

                    <article class="@(
                                 _overview.Plan == BillingPlan.Plus
                                     ? "billing-plan-card billing-plan-card-current"
                                     : "billing-plan-card")">
                        <div class="billing-plan-card-heading">
                            <div>
                                <h5>
                                    @T["Billing.Plan.Plus"]
                                </h5>

                                <p>
                                    @T["Billing.Plan.PlusDescription"]
                                </p>
                            </div>

                            @if (_overview.Plan == BillingPlan.Plus)
                            {
                                <span class="ui-badge ui-badge-brand">
                                    @T["Billing.Plans.Current"]
                                </span>
                            }
                        </div>

                        <div class="billing-plan-price">
                            <strong>
                                @GetPriceText(BillingPlan.Plus)
                            </strong>

                            <span>
                                @(_selectedBillingInterval ==
                                    BillingInterval.Monthly
                                    ? T["Billing.Plans.PerMonth"]
                                    : T["Billing.Plans.PerYear"])
                            </span>
                        </div>

                        <ul class="billing-plan-features">
                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Plus.Feature1"]
                            </li>

                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Plus.Feature2"]
                            </li>

                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Plus.Feature3"]
                            </li>
                        </ul>

                        <button class="primary-button"
                                type="button"
                                disabled="@(
                                    !PaidPlansEnabled ||
                                    _isProcessing ||
                                    GetPrice(BillingPlan.Plus) is null ||
                                    (_overview.Plan ==
                                        BillingPlan.Plus &&
                                     _overview.BillingInterval ==
                                        _selectedBillingInterval))"
                                @onclick="@(
                                    () => SelectPlanAsync(
                                        BillingPlan.Plus))">
                            @if (_overview.Plan == BillingPlan.Plus &&
                                 _overview.BillingInterval ==
                                     _selectedBillingInterval)
                            {
                                @T["Billing.Plans.Current"]
                            }
                            else if (!PaidPlansEnabled)
                            {
                                @T["Billing.Plans.Unavailable"]
                            }
                            else if (_isProcessing)
                            {
                                @T["Billing.Plans.Processing"]
                            }
                            else
                            {
                                @T["Billing.Plans.Select"]
                            }
                        </button>
                    </article>

                    <article class="@(
                                 _overview.Plan == BillingPlan.Premium
                                     ? "billing-plan-card billing-plan-card-current billing-plan-card-featured"
                                     : "billing-plan-card billing-plan-card-featured")">
                        <div class="billing-plan-card-heading">
                            <div>
                                <span class="billing-plan-recommended">
                                    @T["Billing.Plans.Recommended"]
                                </span>

                                <h5>
                                    @T["Billing.Plan.Premium"]
                                </h5>

                                <p>
                                    @T["Billing.Plan.PremiumDescription"]
                                </p>
                            </div>

                            @if (_overview.Plan == BillingPlan.Premium)
                            {
                                <span class="ui-badge ui-badge-brand">
                                    @T["Billing.Plans.Current"]
                                </span>
                            }
                        </div>

                        <div class="billing-plan-price">
                            <strong>
                                @GetPriceText(BillingPlan.Premium)
                            </strong>

                            <span>
                                @(_selectedBillingInterval ==
                                    BillingInterval.Monthly
                                    ? T["Billing.Plans.PerMonth"]
                                    : T["Billing.Plans.PerYear"])
                            </span>
                        </div>

                        <ul class="billing-plan-features">
                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Premium.Feature1"]
                            </li>

                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Premium.Feature2"]
                            </li>

                            <li>
                                <AppIcon Name="check" />
                                @T["Billing.Plan.Premium.Feature3"]
                            </li>
                        </ul>

                        <button class="primary-button"
                                type="button"
                                disabled="@(
                                    !PaidPlansEnabled ||
                                    _isProcessing ||
                                    GetPrice(BillingPlan.Premium) is null ||
                                    (_overview.Plan ==
                                        BillingPlan.Premium &&
                                     _overview.BillingInterval ==
                                        _selectedBillingInterval))"
                                @onclick="@(
                                    () => SelectPlanAsync(
                                        BillingPlan.Premium))">
                            @if (_overview.Plan == BillingPlan.Premium &&
                                 _overview.BillingInterval ==
                                     _selectedBillingInterval)
                            {
                                @T["Billing.Plans.Current"]
                            }
                            else if (!PaidPlansEnabled)
                            {
                                @T["Billing.Plans.Unavailable"]
                            }
                            else if (_isProcessing)
                            {
                                @T["Billing.Plans.Processing"]
                            }
                            else
                            {
                                @T["Billing.Plans.Select"]
                            }
                        </button>
                    </article>
                </div>
            }
        </section>
    }
    else if (_stage == BillingSettingsStage.ChangeConfirmation &&
             _changePreview is not null)
    {
        <section class="billing-change-confirmation"
                 aria-labelledby="billing-change-title">
            <div class="billing-section-heading">
                <div>
                    <span class="ui-badge ui-badge-brand">
                        @T["Billing.Change.Badge"]
                    </span>

                    <h4 id="billing-change-title">
                        @T["Billing.Change.Title"]
                    </h4>

                    <p>
                        @T["Billing.Change.Description"]
                    </p>
                </div>
            </div>

            <dl class="billing-details">
                <div>
                    <dt>
                        @T["Billing.Change.CurrentPlan"]
                    </dt>

                    <dd>@ChangeCurrentPlanLabel</dd>
                </div>

                <div>
                    <dt>
                        @T["Billing.Change.NewPlan"]
                    </dt>

                    <dd>@ChangeTargetPlanLabel</dd>
                </div>

                <div>
                    <dt>
                        @T["Billing.Change.Timing"]
                    </dt>

                    <dd>@ChangeTimingLabel</dd>
                </div>

                <div>
                    <dt>
                        @T["Billing.Change.EffectiveAt"]
                    </dt>

                    <dd>@ChangeEffectiveDateText</dd>
                </div>

                <div>
                    <dt>
                        @T["Billing.Change.AmountDueNow"]
                    </dt>

                    <dd>@ChangeAmountDueNowText</dd>
                </div>
            </dl>

            @if (_changePreview.Timing ==
                 BillingSubscriptionChangeTiming.Immediate)
            {
                <div class="ui-alert ui-alert-warning"
                     role="status">
                    <strong>
                        @T["Billing.Change.ImmediateTitle"]
                    </strong>

                    <span>
                        @T["Billing.Change.ImmediateDescription"]
                    </span>
                </div>
            }
            else
            {
                <div class="ui-alert ui-alert-warning"
                     role="status">
                    <strong>
                        @T["Billing.Change.ScheduledTitle"]
                    </strong>

                    <span>
                        @string.Format(
                            T["Billing.Change.ScheduledDescription"],
                            ChangeEffectiveDateText)
                    </span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_operationError))
            {
                <div class="ui-alert ui-alert-error"
                     role="alert">
                    @_operationError
                </div>
            }

            <div class="billing-actions">
                <button class="secondary-button"
                        type="button"
                        disabled="@_isProcessing"
                        @onclick="OpenPlanSelection">
                    @T["Action.Back"]
                </button>

                <button class="primary-button"
                        type="button"
                        disabled="@(
                            _isProcessing ||
                            !PaidPlansEnabled)"
                        @onclick="ConfirmChangeAsync">
                    @(_isProcessing
                        ? T["Billing.Change.Processing"]
                        : T["Billing.Change.Confirm"])
                </button>
            </div>
        </section>
    }
    else if (
        _stage ==
        BillingSettingsStage.CancellationConfirmation)
    {
        <section class="billing-cancellation-confirmation"
                 aria-labelledby="billing-cancellation-title">
            <span class="billing-cancellation-icon"
                  aria-hidden="true">
                <AppIcon Name="subscriptions" />
            </span>

            <h4 id="billing-cancellation-title">
                @T["Billing.Cancellation.Title"]
            </h4>

            <p>
                @string.Format(
                    T["Billing.Cancellation.Description"],
                    CurrentPeriodEndText)
            </p>

            <div class="ui-alert ui-alert-warning"
                 role="status">
                <strong>
                    @T["Billing.Cancellation.AccessTitle"]
                </strong>

                <span>
                    @string.Format(
                        T["Billing.Cancellation.AccessDescription"],
                        CurrentPeriodEndText)
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_operationError))
            {
                <div class="ui-alert ui-alert-error"
                     role="alert">
                    @_operationError
                </div>
            }

            <div class="billing-actions">
                <button class="secondary-button"
                        type="button"
                        disabled="@_isProcessing"
                        @onclick="BackToOverview">
                    @T["Action.Back"]
                </button>

                <button class="text-button billing-cancel-button"
                        type="button"
                        disabled="@_isProcessing"
                        @onclick="ConfirmCancellationAsync">
                    @(_isProcessing
                        ? T["Billing.Cancellation.Processing"]
                        : T["Billing.Cancellation.Confirm"])
                </button>
            </div>
        </section>
    }
}
