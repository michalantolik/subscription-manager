@inject UiState State
@inject Localizer T

<nav class="side-nav"
     aria-label="Main navigation">
    <AuthorizeView>
        <Authorized>
            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="nav-item"
                     @onclick="State.CloseMobileMenu">
                <span class="nav-icon">
                    <AppIcon Name="home" />
                </span>

                <span class="nav-label">
                    @T["Navigation.Overview"]
                </span>
            </NavLink>

            <NavLink href="/subscriptions"
                     Match="NavLinkMatch.Prefix"
                     class="nav-item"
                     @onclick="State.CloseMobileMenu">
                <span class="nav-icon">
                    <AppIcon Name="subscriptions" />
                </span>

                <span class="nav-label">
                    @T["Navigation.Subscriptions"]
                </span>
            </NavLink>

            <NavLink href="/savings-plan"
                     Match="NavLinkMatch.Prefix"
                     class="nav-item"
                     @onclick="State.CloseMobileMenu">
                <span class="nav-icon">
                    <AppIcon Name="target" />
                </span>

                <span class="nav-label">
                    @T["Navigation.SavingsPlan"]
                </span>
            </NavLink>
        </Authorized>

        <NotAuthorized>
            <NavLink href="/login"
                     Match="NavLinkMatch.All"
                     class="nav-item"
                     @onclick="State.CloseMobileMenu">
                <span class="nav-icon">
                    <AppIcon Name="home" />
                </span>

                <span class="nav-label">
                    @T["Navigation.Login"]
                </span>
            </NavLink>

            <NavLink href="/about"
                     Match="NavLinkMatch.All"
                     class="nav-item"
                     @onclick="State.CloseMobileMenu">
                <span class="nav-icon">
                    <AppIcon Name="info" />
                </span>

                <span class="nav-label">
                    @T["Navigation.About"]
                </span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

<button class="sidebar-collapse"
        type="button"
        @onclick="State.ToggleSidebar">
    <span class="collapse-icon @(State.IsSidebarCollapsed ? "is-collapsed" : null)">
        <AppIcon Name="chevron" />
    </span>

    <span>
        @(State.IsSidebarCollapsed
            ? T["Layout.Expand"]
            : T["Layout.Collapse"])
    </span>
</button>
