@using SubscriptionManager.Web.Features.DigitalServices

@if (DigitalServiceBrandIconRegistry.Contains(IconKey))
{
    <span class="digital-service-icon"
          style="@IconStyle"
          aria-hidden="true"></span>
}
else
{
    <AppIcon Name="@FallbackIcon" />
}

@code {
    [Parameter]
    public string? IconKey { get; set; }

    [Parameter, EditorRequired]
    public string FallbackIcon { get; set; } = "other";

    private string IconStyle =>
        $"--digital-service-icon: url('/images/digital-services/{IconKey}.svg')";
}
