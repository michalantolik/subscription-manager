@page "/"

@attribute [Authorize]
@implements IDisposable

@using SubscriptionManager.Blazor.Features.Currencies

@inject SubscriptionsApiClient ApiClient
@inject AppState State
@inject Localizer T
@inject NavigationManager Navigation

<PageTitle>Subscription Manager — @T["Navigation.Overview"]</PageTitle>

<section class="page subscriptions-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">@T["Overview.Eyebrow"]</p>
            <h1>@T["Overview.Title"]</h1>
            <p>@T["Overview.Description"]</p>
        </div>

        <a class="primary-action"
           href="/subscriptions">
            <AppIcon Name="subscriptions" />
            @T["Navigation.Subscriptions"]
        </a>
    </div>

    @if (_loading)
    {
        <div class="panel loading-panel">
            @T["Status.Loading"]
        </div>
    }
    else if (_error || _summary is null)
    {
        <div class="panel error-panel">
            @T["Error.Load"]
        </div>
    }
    else
    {
        <div class="metrics-grid">
            <article class="metric-tile">
                <span>@T["Subscriptions.Active"]</span>
                <strong>@_summary.ActiveCount</strong>
                <small>
                    @T[
                        "Subscriptions.OfAll",
                        _summary.TotalCount]
                </small>
            </article>

            <article class="metric-tile">
                <span>@T["Subscriptions.Monthly"]</span>
                <strong>
                    @Money(
                        _summary.MonthlyCost)
                </strong>
                <small>
                    @T[
                        "Subscriptions.AverageMonthly",
                        Money(
                            _summary.AverageMonthlyCost)]
                </small>
            </article>

            <article class="metric-tile">
                <span>@T["Subscriptions.Yearly"]</span>
                <strong>
                    @Money(
                        _summary.YearlyCost)
                </strong>
                <small>
                    @T[
                        "Subscriptions.AverageYearly",
                        Money(
                            _summary.AverageYearlyCost)]
                </small>
            </article>

            <article class="metric-tile">
                <span>@T["Subscriptions.MostExpensive"]</span>
                <strong>
                    @Money(
                        MostExpensive?
                            .MonthlyCost ?? 0m)
                </strong>
                <small>
                    @(MostExpensive?.Name ?? "—")
                </small>
            </article>
        </div>

        <div class="overview-grid">
            <section class="panel overview-list">
                <div class="panel-heading">
                    <div>
                        <h2>@T["Subscriptions.ListTitle"]</h2>
                        <p>@T["Subscriptions.ListDescription"]</p>
                    </div>

                    <a href="/subscriptions">
                        @T["Filter.All"]
                    </a>
                </div>

                @foreach (
                    var subscription in
                    _summary.TopSubscriptions)
                {
                    <div class="compact-subscription-row">
                        <span class="service-avatar">
                            @Initials(subscription.Name)
                        </span>

                        <div>
                            <strong>@subscription.Name</strong>
                            <small>
                                @Billing(
                                    subscription.BillingPeriod)
                            </small>
                        </div>

                        <b>
                            @Money(
                                subscription.MonthlyCost)
                        </b>
                    </div>
                }

                @if (_summary.ActiveCount == 0)
                {
                    <div class="empty-inline">
                        @T["Empty.Description"]
                    </div>
                }
            </section>

            <section class="panel overview-summary">
                <div class="panel-heading">
                    <div>
                        <h2>@T["Subscriptions.Monthly"]</h2>
                        <p>@SummaryDescription</p>
                    </div>
                </div>

                <div class="summary-ring">
                    <strong>
                        @Money(
                            _summary.MonthlyCost)
                    </strong>
                    <span>@T["PerMonth"]</span>
                </div>
            </section>
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask
    {
        get;
        set;
    } = default!;

    private SubscriptionCostSummaryResponse? _summary;

    private bool _loading = true;
    private bool _error;

    private SubscriptionCostSummaryItemResponse? MostExpensive =>
        _summary?.TopSubscriptions.FirstOrDefault();

    private string SummaryDescription
    {
        get
        {
            if (_summary?.ExchangeRateEffectiveDate is not { } date)
            {
                return T["Subscriptions.Description"];
            }

            return T[
                "Subscriptions.ExchangeRatesAsOf",
                FormatDate(date)];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        State.BaseCurrencyChanged +=
            OnBaseCurrencyChanged;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;

        try
        {
            var authenticationState =
                await AuthenticationStateTask;

            _summary =
                await ApiClient.GetCostSummaryAsync(
                    authenticationState.User);
        }
        catch (HttpRequestException exception)
            when (exception.StatusCode ==
                  System.Net.HttpStatusCode.Unauthorized)
        {
            SessionExpirationNavigation.RedirectToLogin(
                Navigation);
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnBaseCurrencyChanged()
    {
        _ = InvokeAsync(
            async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
    }

    public void Dispose()
    {
        State.BaseCurrencyChanged -=
            OnBaseCurrencyChanged;
    }

    private string Money(
        decimal value)
    {
        var currency =
            _summary?.BaseCurrency ??
            Currency.PLN;

        return string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            "{0:N2} {1}",
            value,
            currency);
    }

    private static string Initials(
        string name)
    {
        return string.Concat(
            name.Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part =>
                    char.ToUpperInvariant(part[0])));
    }

    private string Billing(
        BillingPeriod period)
    {
        return T[$"Billing.{period}"];
    }

    private static string FormatDate(
        DateOnly date)
    {
        return date.ToString(
            "d",
            System.Globalization.CultureInfo.CurrentCulture);
    }
}
