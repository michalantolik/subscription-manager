@using System.Security.Claims
@using SubscriptionManager.Blazor.Features.Account
@using SubscriptionManager.Blazor.Features.Authentication
@using SubscriptionManager.Blazor.Features.Currencies
@using SubscriptionManager.Blazor.Features.Localization
@inject AccountApiClient AccountApiClient
@inject AuthenticationApiClient AuthenticationApiClient
@inject AppState State
@inject Localizer T
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="ui-dialog-backdrop account-dialog-backdrop"
     @onclick="CloseFromBackdrop">
    <section class="ui-dialog ui-dialog-small account-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="account-dialog-title"
             @onclick:stopPropagation="true">
        <header class="ui-dialog-header">
            <div class="ui-dialog-heading">
                <span class="ui-dialog-mark @(_stage == DialogStage.Confirm ? "account-dialog-mark-danger" : null)">
                    <AppIcon Name="@(_stage == DialogStage.Confirm ? "trash" : "settings")" />
                </span>

                <div>
                    <h2 class="ui-dialog-title"
                        id="account-dialog-title">
                        @DialogTitle
                    </h2>

                    <p class="ui-dialog-description">
                        @DialogDescription
                    </p>
                </div>
            </div>

            @if (_stage is DialogStage.Settings or DialogStage.Confirm)
            {
                <button class="ui-dialog-close"
                        type="button"
                        title="@T["Action.Close"]"
                        @onclick="CloseAsync">
                    <AppIcon Name="close" />
                </button>
            }
        </header>

        <div class="ui-dialog-body">
            @if (_stage == DialogStage.Settings)
            {
                <div class="account-settings-content">
                    <section class="account-profile-card">
                        <span class="account-profile-avatar">
                            @Initial
                        </span>

                        <div>
                            <strong>@Email</strong>
                            <span>@T["Account.Settings.ActiveAccount"]</span>
                        </div>
                    </section>

                    <section class="account-preferences">
                        <div class="account-preferences-heading">
                            <h3>@T["Account.Preferences.Title"]</h3>
                            <p>@T["Account.Preferences.Description"]</p>
                        </div>

                        @if (_isLoadingPreferences)
                        {
                            <div class="account-preferences-loading"
                                 role="status">
                                <span class="account-preferences-spinner"
                                      aria-hidden="true"></span>
                                @T["Account.Preferences.Loading"]
                            </div>
                        }
                        else
                        {
                            <div class="account-preferences-fields">
                                <label class="account-preference-field">
                                    <span>@T["Account.Preferences.LanguageLabel"]</span>

                                    <select @bind="_language"
                                            disabled="@_isSavingPreferences">
                                        @foreach (var language in Enum.GetValues<Language>())
                                        {
                                            <option value="@language">
                                                @GetLanguageName(language)
                                            </option>
                                        }
                                    </select>

                                    <small>
                                        @T["Account.Preferences.LanguageDescription"]
                                    </small>
                                </label>

                                <label class="account-preference-field">
                                    <span>@T["Account.Preferences.CurrencyLabel"]</span>

                                    <select @bind="_baseCurrency"
                                            disabled="@_isSavingPreferences">
                                        @foreach (var currency in Enum.GetValues<Currency>())
                                        {
                                            <option value="@currency">
                                                @currency
                                            </option>
                                        }
                                    </select>

                                    <small>
                                        @T["Account.Preferences.CurrencyDescription"]
                                    </small>
                                </label>
                            </div>

                            <div class="account-preferences-actions">
                                <button class="primary-button"
                                        type="button"
                                        disabled="@(_isSavingPreferences || !PreferencesChanged)"
                                        @onclick="SavePreferencesAsync">
                                    @(_isSavingPreferences
                                        ? T["Account.Preferences.Saving"]
                                        : T["Account.Preferences.Save"])
                                </button>
                            </div>
                        }

                        @if (_preferencesSaved)
                        {
                            <div class="account-preferences-message account-preferences-message-success"
                                 role="status">
                                @T["Account.Preferences.Saved"]
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_preferencesError))
                        {
                            <div class="account-preferences-message account-preferences-message-error"
                                 role="alert">
                                @_preferencesError
                            </div>
                        }
                    </section>

                    <section class="account-danger-zone">
                        <div>
                            <span class="ui-badge ui-badge-danger">
                                @T["Account.Settings.DangerZone"]
                            </span>

                            <h3>@T["Account.Delete.Title"]</h3>

                            <p>@T["Account.Delete.Summary"]</p>
                        </div>

                        <button class="danger-button"
                                type="button"
                                @onclick="OpenConfirmation">
                            <AppIcon Name="trash" />
                            @T["Account.Delete.Action"]
                        </button>
                    </section>
                </div>
            }
            else if (_stage == DialogStage.Confirm)
            {
                <div class="account-confirmation">
                    <div class="ui-alert ui-alert-error"
                         role="alert">
                        <strong>@T["Account.Delete.WarningTitle"]</strong>
                        <ul class="ui-alert-list account-delete-list">
                            <li>@T["Account.Delete.WarningAccount"]</li>
                            <li>@T["Account.Delete.WarningSubscriptions"]</li>
                            <li>@T["Account.Delete.WarningServices"]</li>
                            <li>@T["Account.Delete.WarningSignOut"]</li>
                        </ul>
                    </div>

                    <label class="account-confirm-checkbox">
                        <input type="checkbox"
                               @bind="_confirmed" />
                        <span>@T["Account.Delete.Confirmation"]</span>
                    </label>

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="ui-alert ui-alert-error"
                             role="alert">
                            @_error
                        </div>
                    }
                </div>
            }
            else if (_stage == DialogStage.Deleting)
            {
                <div class="account-operation-state"
                     role="status">
                    <span class="account-spinner"
                          aria-hidden="true"></span>
                    <strong>@T["Account.Delete.DeletingTitle"]</strong>
                    <p>@T["Account.Delete.DeletingDescription"]</p>
                </div>
            }
            else
            {
                <div class="account-operation-state account-operation-success"
                     role="status">
                    <span class="account-success-icon">
                        <AppIcon Name="check" />
                    </span>
                    <strong>@T["Account.Delete.SuccessTitle"]</strong>
                    <p>@T["Account.Delete.SuccessDescription"]</p>
                </div>
            }
        </div>

        @if (_stage == DialogStage.Settings)
        {
            <footer class="ui-dialog-footer">
                <button class="secondary-button"
                        type="button"
                        @onclick="CloseAsync">
                    @T["Action.Close"]
                </button>
            </footer>
        }
        else if (_stage == DialogStage.Confirm)
        {
            <footer class="ui-dialog-footer">
                <button class="secondary-button"
                        type="button"
                        @onclick="BackToSettings">
                    @T["Action.Cancel"]
                </button>

                <button class="danger-button"
                        type="button"
                        disabled="@(!_confirmed)"
                        @onclick="DeleteAccountAsync">
                    <AppIcon Name="trash" />
                    @T["Account.Delete.PermanentAction"]
                </button>
            </footer>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private CancellationTokenSource? _cancellationTokenSource;
    private DialogStage _stage = DialogStage.Settings;

    private Language _language = Language.Polish;
    private Language _savedLanguage = Language.Polish;
    private Currency _baseCurrency = Currency.PLN;
    private Currency _savedBaseCurrency = Currency.PLN;

    private bool _isLoadingPreferences = true;
    private bool _isSavingPreferences;
    private bool _preferencesSaved;
    private bool _confirmed;

    private string? _preferencesError;
    private string? _error;

    private bool PreferencesChanged =>
        _language != _savedLanguage ||
        _baseCurrency != _savedBaseCurrency;

    private string Email =>
        User.FindFirst(ClaimTypes.Email)?.Value ??
        User.Identity?.Name ??
        T["Account.Settings.UnknownUser"];

    private string Initial =>
        Email.Length == 0
            ? "U"
            : char.ToUpperInvariant(Email[0]).ToString();

    private string DialogTitle => _stage switch
    {
        DialogStage.Settings => T["Account.Settings.Title"],
        DialogStage.Confirm => T["Account.Delete.ConfirmTitle"],
        DialogStage.Deleting => T["Account.Delete.DeletingTitle"],
        _ => T["Account.Delete.SuccessTitle"]
    };

    private string DialogDescription => _stage switch
    {
        DialogStage.Settings => T["Account.Settings.Description"],
        DialogStage.Confirm => T["Account.Delete.ConfirmDescription"],
        DialogStage.Deleting => T["Account.Delete.DeletingDescription"],
        _ => T["Account.Delete.SuccessDescription"]
    };

    protected override async Task OnInitializedAsync()
    {
        _cancellationTokenSource =
            new CancellationTokenSource();

        await LoadPreferencesAsync();
    }

    private async Task LoadPreferencesAsync()
    {
        _isLoadingPreferences = true;
        _preferencesSaved = false;
        _preferencesError = null;

        try
        {
            var preferences =
                await AccountApiClient.GetPreferencesAsync(
                    User,
                    _cancellationTokenSource!.Token);

            _language = preferences.Language;
            _savedLanguage = preferences.Language;
            _baseCurrency = preferences.BaseCurrency;
            _savedBaseCurrency = preferences.BaseCurrency;
        }
        catch (HttpRequestException)
        {
            _preferencesError =
                T["Account.Preferences.Error"];
        }
        catch (InvalidOperationException)
        {
            _preferencesError =
                T["Account.Preferences.Error"];
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _isLoadingPreferences = false;
        }
    }

    private async Task SavePreferencesAsync()
    {
        if (_isSavingPreferences || !PreferencesChanged)
        {
            return;
        }

        _isSavingPreferences = true;
        _preferencesSaved = false;
        _preferencesError = null;

        var languageChanged =
            _language != _savedLanguage;

        var baseCurrencyChanged =
            _baseCurrency != _savedBaseCurrency;

        try
        {
            await AccountApiClient.UpdatePreferencesAsync(
                _language,
                _baseCurrency,
                User,
                _cancellationTokenSource!.Token);

            _savedLanguage = _language;
            _savedBaseCurrency = _baseCurrency;

            if (baseCurrencyChanged)
            {
                State.NotifyBaseCurrencyChanged();
            }

            if (languageChanged)
            {
                ApplySelectedLanguage();
                return;
            }

            _preferencesSaved = true;
        }
        catch (HttpRequestException)
        {
            _preferencesError =
                T["Account.Preferences.Error"];
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _isSavingPreferences = false;
        }
    }

    private void ApplySelectedLanguage()
    {
        var culture =
            _language.ToCultureName();

        var relativePath =
            Navigation.ToBaseRelativePath(
                Navigation.Uri);

        var redirectUri =
            string.IsNullOrWhiteSpace(relativePath)
                ? "/"
                : $"/{relativePath}";

        Navigation.NavigateTo(
            $"/culture/set?culture={Uri.EscapeDataString(culture)}" +
            $"&redirectUri={Uri.EscapeDataString(redirectUri)}",
            forceLoad: true);
    }

    private static string GetLanguageName(
        Language language)
    {
        return language switch
        {
            Language.Polish => "Polski",
            Language.English => "English",
            Language.German => "Deutsch",
            _ => throw new ArgumentOutOfRangeException(
                nameof(language),
                language,
                "The language is not supported.")
        };
    }

    private void OpenConfirmation()
    {
        _confirmed = false;
        _error = null;
        _stage = DialogStage.Confirm;
    }

    private void BackToSettings()
    {
        _confirmed = false;
        _error = null;
        _stage = DialogStage.Settings;
    }

    private async Task DeleteAccountAsync()
    {
        if (!_confirmed || _stage != DialogStage.Confirm)
        {
            return;
        }

        _error = null;
        _stage = DialogStage.Deleting;

        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource =
            new CancellationTokenSource();

        try
        {
            var result =
                await AuthenticationApiClient.DeleteAccountAsync(
                    User,
                    _cancellationTokenSource.Token);

            if (!result.Succeeded)
            {
                _error = T["Account.Delete.Error"];
                _stage = DialogStage.Confirm;
                return;
            }

            _stage = DialogStage.Deleted;

            await Task.Delay(
                TimeSpan.FromSeconds(2),
                _cancellationTokenSource.Token);

            Navigation.NavigateTo(
                "/authentication/account-deleted",
                forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _error = T["Account.Delete.Error"];
            _stage = DialogStage.Confirm;
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task CloseFromBackdrop()
        => _stage is DialogStage.Settings or DialogStage.Confirm
            ? CloseAsync()
            : Task.CompletedTask;

    private async Task CloseAsync()
    {
        if (_stage is DialogStage.Deleting or DialogStage.Deleted)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    public ValueTask DisposeAsync()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();

        return ValueTask.CompletedTask;
    }

    private enum DialogStage
    {
        Settings,
        Confirm,
        Deleting,
        Deleted
    }
}
