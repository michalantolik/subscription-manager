@using System.Globalization
@using System.Security.Claims
@inject AppState State
@inject Localizer T
@inject NavigationManager Navigation
@inject IJSRuntime JS

<header class="topbar">
    <button class="icon-button mobile-menu-button"
            type="button"
            @onclick="State.ToggleMobileMenu">
        <AppIcon Name="menu" />
    </button>

    <div class="topbar-actions">
        <div class="language-switch"
             aria-label="Language">
            @foreach (var language in Languages)
            {
                <button class="language-button @(CurrentLanguage == language.Code ? "active" : null)"
                        type="button"
                        @onclick="() => ChangeLanguage(language.Code)">
                    @language.Label
                </button>
            }
        </div>

        <button class="icon-button"
                type="button"
                @onclick="ToggleThemeAsync">
            <AppIcon Name="@(State.Theme == AppState.LightTheme ? "moon" : "sun")" />
        </button>

        <button class="icon-button notification-button"
                type="button">
            <AppIcon Name="bell" />
            <span></span>
        </button>

        <AuthorizeView>
            <Authorized Context="authenticationState">
                <div class="account-menu-container">
                    @if (_accountMenuOpen)
                    {
                        <button class="account-menu-overlay"
                                type="button"
                                aria-label="@T["Action.Close"]"
                                @onclick="CloseAccountMenu"></button>
                    }

                    <button class="user-menu"
                            type="button"
                            aria-haspopup="menu"
                            aria-expanded="@_accountMenuOpen"
                            @onclick="ToggleAccountMenu">
                        <span class="user-copy">
                            <strong>
                                @DisplayName(authenticationState.User)
                            </strong>

                            <small>
                                @T["User.Role"]
                            </small>
                        </span>

                        <span class="avatar">
                            @Initial(authenticationState.User)
                        </span>

                        <AppIcon Name="chevron"
                                 CssClass="@AccountMenuChevronClass" />
                    </button>

                    @if (_accountMenuOpen)
                    {
                        <div class="account-menu-dropdown"
                             role="menu">
                            <div class="account-menu-heading">
                                <strong>
                                    @DisplayName(authenticationState.User)
                                </strong>

                                <span>
                                    @T["Account.Menu.Description"]
                                </span>
                            </div>

                            <button class="account-menu-item"
                                    type="button"
                                    role="menuitem"
                                    @onclick="OpenAccountSettings">
                                <AppIcon Name="settings" />

                                <span>
                                    <strong>
                                        @T["Account.Settings.Title"]
                                    </strong>

                                    <small>
                                        @T["Account.Menu.SettingsHint"]
                                    </small>
                                </span>
                            </button>

                            <form method="post"
                                  action="/authentication/logout">
                                <AntiforgeryToken />

                                <button class="account-menu-item"
                                        type="submit"
                                        role="menuitem">
                                    <AppIcon Name="logout" />

                                    <span>
                                        <strong>
                                            @T["Authentication.Logout"]
                                        </strong>

                                        <small>
                                            @T["Account.Menu.LogoutHint"]
                                        </small>
                                    </span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@if (_accountSettingsOpen)
{
    <AuthorizeView>
        <Authorized Context="accountSettingsAuthenticationState">
            <AccountSettingsDialog User="accountSettingsAuthenticationState.User"
                                   OnClose="CloseAccountSettings" />
        </Authorized>
    </AuthorizeView>
}

@code {
    private static readonly (string Code, string Label)[] Languages =
    [
        ("pl", "PL"),
        ("en", "EN"),
        ("de", "DE")
    ];

    private bool _accountMenuOpen;
    private bool _accountSettingsOpen;

    private string CurrentLanguage =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private string AccountMenuChevronClass =>
        _accountMenuOpen
            ? "account-menu-chevron open"
            : "account-menu-chevron";

    private void ToggleAccountMenu()
        => _accountMenuOpen = !_accountMenuOpen;

    private void CloseAccountMenu()
        => _accountMenuOpen = false;

    private void OpenAccountSettings()
    {
        _accountMenuOpen = false;
        _accountSettingsOpen = true;
    }

    private void CloseAccountSettings()
        => _accountSettingsOpen = false;

    private async Task ToggleThemeAsync()
    {
        State.ToggleTheme();

        await JS.InvokeVoidAsync(
            "subscriptionManagerTheme.set",
            State.Theme,
            AppState.ThemeCookieName);
    }

    private void ChangeLanguage(
        string languageCode)
    {
        var culture =
            SupportedCultures.ByLanguageCode.TryGetValue(
                languageCode,
                out var selected)
                ? selected
                : SupportedCultures.DefaultCulture;

        var currentPath =
            Navigation.ToBaseRelativePath(
                Navigation.Uri);

        var redirectUri =
            string.IsNullOrWhiteSpace(currentPath)
                ? "/"
                : $"/{currentPath}";

        Navigation.NavigateTo(
            "/culture/set" +
            $"?culture={Uri.EscapeDataString(culture)}" +
            $"&redirectUri={Uri.EscapeDataString(redirectUri)}",
            forceLoad: true);
    }

    private static string DisplayName(
        ClaimsPrincipal user)
        => user.FindFirst(ClaimTypes.Email)?.Value ??
           user.Identity?.Name ??
           "User";

    private static string Initial(
        ClaimsPrincipal user)
    {
        var displayName = DisplayName(user);

        return displayName.Length == 0
            ? "U"
            : char.ToUpperInvariant(
                displayName[0]).ToString();
    }
}
