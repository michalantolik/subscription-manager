@inject AppState State
@inject Localizer T
@inject NavigationManager Navigation
@inject IJSRuntime JS

<header class="topbar">
    <button class="icon-button mobile-menu-button"
            type="button"
            @onclick="State.ToggleMobileMenu">
        <AppIcon Name="menu" />
    </button>

    <div class="topbar-actions">
        <div class="language-switch"
             aria-label="Language">
            @foreach (var language in Languages)
            {
                <button class="language-button @(CurrentLanguage == language.Code ? "active" : null)"
                        type="button"
                        @onclick="() => ChangeLanguage(language.Code)">
                    @language.Label
                </button>
            }
        </div>

        <button class="icon-button"
                type="button"
                @onclick="ToggleThemeAsync">
            <AppIcon Name="@(State.Theme == AppState.LightTheme ? "moon" : "sun")" />
        </button>

        <AuthorizeView>
            <Authorized Context="authenticationState">
                <div class="account-menu-container">
                    @if (_accountMenuOpen)
                    {
                        <button class="account-menu-overlay"
                                type="button"
                                aria-label="@T["Action.Close"]"
                                @onclick="CloseAccountMenu"></button>
                    }

                    <button class="user-menu"
                            type="button"
                            aria-haspopup="menu"
                            aria-expanded="@_accountMenuOpen"
                            @onclick="ToggleAccountMenu">
                        <span class="user-copy">
                            <strong>
                                @DisplayName(authenticationState.User)
                            </strong>
                        </span>

                        <span class="avatar">
                            @Initial(authenticationState.User)
                        </span>

                        <AppIcon Name="chevron"
                                 CssClass="@AccountMenuChevronClass" />
                    </button>

                    @if (_accountMenuOpen)
                    {
                        <div class="account-menu-dropdown"
                             role="menu">
                            <div class="account-menu-heading">
                                <strong>
                                    @DisplayName(authenticationState.User)
                                </strong>

                                <span>
                                    @T["Account.Menu.Description"]
                                </span>
                            </div>

                            <button class="account-menu-item"
                                    type="button"
                                    role="menuitem"
                                    @onclick="OpenAccountSettings">
                                <AppIcon Name="settings" />

                                <span>
                                    <strong>
                                        @T["Account.Settings.Title"]
                                    </strong>

                                    <small>
                                        @T["Account.Menu.SettingsHint"]
                                    </small>
                                </span>
                            </button>

                            <form method="post"
                                  action="/authentication/logout">
                                <AntiforgeryToken />

                                <button class="account-menu-item"
                                        type="submit"
                                        role="menuitem">
                                    <AppIcon Name="logout" />

                                    <span>
                                        <strong>
                                            @T["Authentication.Logout"]
                                        </strong>

                                        <small>
                                            @T["Account.Menu.LogoutHint"]
                                        </small>
                                    </span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@if (_accountSettingsOpen)
{
    <AuthorizeView>
        <Authorized Context="accountSettingsAuthenticationState">
            <AccountSettingsDialog User="accountSettingsAuthenticationState.User"
                                   OnClose="CloseAccountSettings" />
        </Authorized>
    </AuthorizeView>
}
